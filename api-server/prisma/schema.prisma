generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  READY
  FAILED
}

enum RepoProvider {
  GITHUB
  GITLAB
  BITBUCKET
  OTHER
}

enum DeployTrigger {
  MANUAL
  WEBHOOK
  ROLLBACK
  REDEPLOY
  GH_PUSH
  GH_PR
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String?
  image    String?
  password String?

  emailVerified     Boolean   @default(false)
  verifyToken       String?
  verifyTokenExpiry DateTime?

  resetToken       String?
  resetTokenExpiry DateTime?

  plan              Plan    @default(FREE)
  razorpayOrderId   String?
  razorpayPaymentId String?

  githubUsername String?
  githubToken    String?
  role           String?
  bio            String?
  company        String?

  totpSecret  String?
  totpEnabled Boolean @default(false)

  projects      Project[]
  loginSessions LoginSession[]
  apiKeys       ApiKey[]
  memberships   OrganizationMembership[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecommendationOutcome {
  id                String   @id @default(uuid())
  recommendationId  String
  applied           Boolean
  improvementMetric String?
  improvementValue  Float?
  createdAt         DateTime @default(now())
}

model DeploymentSignal {
  id           String @id @default(uuid())
  deploymentId String

  nodeVersion     String?
  packageManager  String?
  dependencyCount Int?
  buildTimeMs     Int?
  installTimeMs   Int?
  bundleTimeMs    Int?
  warningsCount   Int?

  createdAt DateTime @default(now())

  @@index([deploymentId])
}

model EngineeringRule {
  id          String @id @default(uuid())
  code        String @unique
  title       String
  description String

  condition Json
  severity  String // low | medium | high
  impact    String // performance | stability | cost | scale

  recommendation String
  createdAt      DateTime @default(now())
}

model DeploymentRecommendation {
  id           String @id @default(uuid())
  deploymentId String
  ruleCode     String

  title          String
  explanation    String
  recommendation String

  severity   String
  impact     String
  confidence Float // 0 → 1

  applied   Boolean?
  createdAt DateTime @default(now())
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMembership[]
  projects    Project[]
  invitations Invitation[]
}

model OrganizationMembership {
  id       String   @id @default(uuid())
  orgId    String
  userId   String
  role     OrgRole  @default(MEMBER)
  joinedAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId])
}

model Invitation {
  id        String   @id @default(uuid())
  orgId     String
  email     String
  role      OrgRole  @default(MEMBER)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

model Project {
  id String @id @default(uuid())

  name   String
  gitURL String @map("git_url")

  slug      String @unique
  subDomain String @unique @map("subdomain")

  customDomain            String? @unique @map("custom_domain")
  domainVerified          Boolean @default(false)
  domainVerificationToken String? @unique

  repoProvider RepoProvider @default(GITHUB)
  framework    String?

  // Build configuration
  buildCommand   String? @map("build_command")
  outputDir      String? @map("output_dir")
  installCommand String? @map("install_command")
  rootDir        String? @map("root_dir")

  // Deploy hooks & notifications
  deployHookToken  String? @unique @map("deploy_hook_token")
  notifyWebhookUrl String? @map("notify_webhook_url")

  isActive Boolean @default(true)

  isPublished Boolean @default(true)

  deployedAt     DateTime?
  lastDeployedAt DateTime?

  latestDeploymentId String?

  // GitHub integration fields
  githubOwner           String?
  githubRepo            String?
  githubDefaultBranch   String? @default("main")
  deploymentRetentionCount Int  @default(3)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id])

  deployments          Deployment[]
  environmentVariables EnvironmentVariable[]
  requestLogs          RequestLog[]
  uptimeChecks         UptimeCheck[]
  cronJobs             CronJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([slug])
  @@index([orgId])
}

model EnvironmentVariable {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  key         String
  value       String   // Encrypted value
  environment String   @default("all") // "all" | "production" | "preview"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, key, environment])
}

model Deployment {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status DeploymentStatus @default(QUEUED)

  isActive Boolean @default(false)

  taskArn     String?
  functionUrl String?

  startedAt  DateTime?
  finishedAt DateTime?

  commitHash String?
  branch     String?

  trigger DeployTrigger @default(MANUAL)

  logsUrl String?

  isPreview        Boolean @default(false) @map("is_preview")
  previewSubdomain String? @unique @map("preview_subdomain")

  prNumber Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs LogEvent[]

  @@index([projectId])
}

model LogEvent {
  id String @id @default(uuid())

  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  log String

  timestamp DateTime @default(now())

  @@index([deploymentId, timestamp])
}

model RequestLog {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  path      String
  status    Int
  latencyMs Int
  cached    Boolean
  country   String?
  city      String?

  @@index([projectId, timestamp])
}

model LoginSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  ip        String?
  userAgent String?
  device    String?
  os        String?
  browser   String?

  createdAt DateTime @default(now())

  @@index([userId])
}

model ApiKey {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  prefix    String
  keyHash   String   @unique

  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model UptimeCheck {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  up         Boolean
  statusCode Int?
  latencyMs  Int?
  checkedAt  DateTime @default(now())

  @@index([projectId, checkedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  projectId   String?
  projectName String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model CronJob {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name       String
  expression String
  endpoint   String?
  useHook    Boolean  @default(false)
  enabled    Boolean  @default(true)

  lastRunAt  DateTime?
  lastStatus String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId])
}
